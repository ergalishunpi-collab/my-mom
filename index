<!DOCTYPE html>
<html lang="kk">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#f7dce8">
  <title>Анашым, мерекеңізбен!</title>
  <style>
    * { box-sizing: border-box; }

    body {
      margin: 0;
      min-height: 100vh;
      min-height: 100svh;
      overflow: hidden;
      font-family: Georgia, "Times New Roman", serif;
      color: #fff;
      background: linear-gradient(135deg, #f8b8ce, #c9b5f5);
      transition: background 2s ease;
    }

    body.scene-1 { background: linear-gradient(135deg, #f8b8ce, #c9b5f5); }
    body.scene-2 { background: linear-gradient(135deg, #f7a7a0, #f5c5d5 55%, #c4b5fd); }
    body.scene-3 { background: linear-gradient(135deg, #f8c7a2, #eab9dd 55%, #b8c5f8); }
    body.scene-4 { background: linear-gradient(135deg, #d7b6f2, #f5b5c8 55%, #ffd6a5); }

    .glow {
      position: fixed;
      inset: 0;
      pointer-events: none;
      background: radial-gradient(ellipse at center, transparent 10%, rgba(80, 27, 74, .22));
    }

    .card {
      position: relative;
      z-index: 2;
      width: min(90vw, 680px);
      max-height: 86vh;
      max-height: 86svh;
      overflow: auto;
      margin: 7vh auto;
      padding: clamp(24px, 6vw, 52px);
      text-align: center;
      border: 1px solid rgba(255,255,255,.55);
      border-radius: 30px;
      background: rgba(255, 255, 255, .18);
      box-shadow: 0 18px 70px rgba(81, 32, 77, .23);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
    }

    .bouquet {
      margin-bottom: 12px;
      font-size: clamp(36px, 10vw, 58px);
      animation: bob 3s ease-in-out infinite;
    }

    h1 {
      margin: 0 0 18px;
      font-size: clamp(30px, 8vw, 54px);
      line-height: 1.12;
      text-shadow: 0 3px 15px rgba(100, 34, 84, .25);
    }

    #message {
      min-height: 150px;
      font-size: clamp(18px, 4.5vw, 23px);
      line-height: 1.65;
      text-shadow: 0 1px 8px rgba(80, 27, 74, .22);
      opacity: 1;
      transition: opacity .7s ease, transform .7s ease;
    }

    #message.changing {
      opacity: 0;
      transform: translateY(10px);
    }

    .signature {
      margin-top: 20px;
      font-size: clamp(17px, 4vw, 21px);
      font-style: italic;
    }

    .heart, .flower {
      position: fixed;
      z-index: 1;
      bottom: -60px;
      pointer-events: none;
      animation: float-up linear forwards;
      filter: drop-shadow(0 3px 5px rgba(90, 30, 70, .2));
    }

    .heart { color: #fff0f5; }
    .flower { opacity: .9; }

    @keyframes float-up {
      from { transform: translateY(0) rotate(0deg); opacity: 0; }
      10% { opacity: 1; }
      90% { opacity: .9; }
      to { transform: translateY(-115vh) rotate(35deg); opacity: 0; }
    }

    @keyframes bob {
      0%, 100% { transform: translateY(0) rotate(-3deg); }
      50% { transform: translateY(-9px) rotate(3deg); }
    }

    @media (max-width: 480px) {
      .card { margin: 5vh auto; max-height: 90vh; max-height: 90svh; }
      #message { min-height: 180px; }
    }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        animation-duration: .01ms !important;
        animation-iteration-count: 1 !important;
        scroll-behavior: auto !important;
      }
      body, #message { transition: none; }
    }
  </style>
</head>
<body class="scene-1">
  <div class="glow"></div>

  <main class="card">
    <div class="bouquet" aria-hidden="true">💐</div>
    <h1>Анашым,<br>мерекеңізбен!</h1>
    <div id="message" aria-live="polite">
      <p>Жан анашым, сізді шын жүректен<br>Аналар күнімен құттықтаймын!</p>
    </div>
    <div class="signature">Сізді шексіз жақсы көретін балаңыздан ❤️</div>
  </main>

  <script>
    const scenes = [
      {
        className: "scene-1",
        text: "<p>Жан анашым, сізді шын жүректен<br>Аналар күнімен құттықтаймын!</p>"
      },
      {
        className: "scene-2",
        text: "<p>Сіз — менің өмірімдегі ең аяулы жансыз.<br>Мейіріміңіз бен жылы сөзіңіз әрдайым жүрегіме күш береді.</p>"
      },
      {
        className: "scene-3",
        text: "<p>Маған сыйлаған махаббатыңыз, қамқорлығыңыз бен ақылыңыз үшін мың алғыс!<br>Сіздің күлкіңіз үйімізге қуаныш сыйлайды.</p>"
      },
      {
        className: "scene-4",
        text: "<p>Деніңіз сау, көңіліңіз шат болсын!<br>Әр күніңіз қуанышқа, жүрегіңіз бақытқа толсын.<br>Армандарыңыз орындалып, жүзіңізден күлкі кетпесін!</p>"
      }
    ];

    const message = document.getElementById("message");
    let currentScene = 0;

    function showScene(index) {
      message.classList.add("changing");

      setTimeout(() => {
        document.body.className = scenes[index].className;
        message.innerHTML = scenes[index].text;
        message.classList.remove("changing");
      }, 500);
    }

    // Әр көрініс 5 секундтан: барлығы 20 секунд.
    const sceneTimer = setInterval(() => {
      currentScene++;

      if (currentScene >= scenes.length) {
        clearInterval(sceneTimer);
        return; // Соңғы тілек экранда қалады.
      }

      showScene(currentScene);
    }, 5000);

    function createFloatingDecoration() {
      const item = document.createElement("span");
      const isFlower = Math.random() > 0.62;
      item.className = isFlower ? "flower" : "heart";
      item.textContent = isFlower
        ? ["🌸", "🌷", "🌼", "💮"][Math.floor(Math.random() * 4)]
        : ["♥", "♡", "💕"][Math.floor(Math.random() * 3)];

      item.style.left = Math.random() * 100 + "vw";
      item.style.fontSize = (18 + Math.random() * 25) + "px";
      item.style.animationDuration = (7 + Math.random() * 7) + "s";

      document.body.appendChild(item);
      setTimeout(() => item.remove(), 15000);
    }

    setInterval(createFloatingDecoration, 420);
  </script>
</body>
</html>
